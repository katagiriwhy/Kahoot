# Copy to ".env" in the repo root (docker compose, Vite, and scripts/sync-public-host-from-env.sh).
# Backend origin as seen from the browser (scheme + host + port, no trailing slash).
# If nginx exposes REST under /api/, set PUBLIC_API_PATH_PREFIX=/api (WebSockets stay at /ws/ on this host).
# If you omit it but PUBLIC_BACKEND_ORIGIN matches the site origin (e.g. both https://kahoot-kroot.duckdns.org), the SPA assumes REST is under /api.
PUBLIC_BACKEND_ORIGIN=http://localhost:8080
# PUBLIC_API_PATH_PREFIX=/api
# PUBLIC_SAME_ORIGIN_NO_API_PREFIX=1

# Production example (HTTPS + DuckDNS):
# PUBLIC_BACKEND_ORIGIN=https://kahoot-kroot.duckdns.org
# SESSION_COOKIE_DOMAIN=kahoot-kroot.duckdns.org
# SESSION_COOKIE_SECURE=true
# CORS_ALLOWED_ORIGINS=https://kahoot-kroot.duckdns.org

SESSION_COOKIE_DOMAIN=localhost
SESSION_COOKIE_SECURE=false

# Comma-separated browser Origins the API will answer with CORS headers for (add Vite + your site). Leave empty to mirror any Origin (dev only).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional: extra Host headers allowed by Vite dev server (defaults include hostname from PUBLIC_BACKEND_ORIGIN).
# VITE_DEV_SERVER_ALLOWED_HOSTS=www.example.com,other.host
